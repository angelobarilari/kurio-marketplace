{
  "name": "kurio-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "assets:images": "node scripts/generate-responsive-images.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-routes.mjs",
    "typecheck": "tsc -b",
    "lint": "prettier --write . && eslint . --fix",
    "lint:check": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --project=unit --reporter=default",
    "test:core": "playwright test tests/checkout.spec.ts --project=chromium-desktop --project=chromium-mobile --grep \"repeated clicks|pending order after|another account order|order terminal|timed-out creation|timeout before creation|rejected wallet\"",
    "test:report": "playwright show-report",
    "test:preview": "node scripts/verify-preview.mjs",
    "test:visual": "playwright test tests/visual.spec.ts tests/account-visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts tests/account-visual.spec.ts --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "audit:lighthouse:matrix": "node scripts/lighthouse-matrix.mjs",
    "audit:lighthouse:prerendered": "node scripts/lighthouse-prerendered-routes.mjs",
    "audit:lighthouse": "lighthouse http://localhost:4173 --output=html --output=json --chrome-flags=--headless",
    "test:integration": "vitest run --project=integration --reporter=default",
    "test:checks": "vitest run",
    "test:coverage:vitest": "vitest run --coverage",
    "test:coverage:refresh-vitest": "vitest run --coverage && node scripts/merge-browser-coverage.mjs --reuse-playwright",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:coverage:report": "node scripts/merge-browser-coverage.mjs --report-only",
    "test:watch": "vitest --reporter=default",
    "typecheck:tests": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "ast-v8-to-istanbul": "1.0.8",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "lighthouse": "^12.8.2",
    "msw": "^2.15.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
